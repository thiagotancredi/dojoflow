# Modelo do .env de produção. No servidor: copie para .env (ao lado do
# compose.prod.yml) e troque os valores. Gere os segredos com:
#   openssl rand -hex 32

# Domínio e e-mail para o certificado HTTPS (Let's Encrypt)
DOMAIN=katsudojo.com.br
ACME_EMAIL=thiagotancredii@gmail.com

# Banco (a API monta a DATABASE_URL a partir desta senha)
POSTGRES_PASSWORD=

# API
ENVIRONMENT=prod
WEB_APP_URL=https://katsudojo.com.br
CORS_ORIGINS=https://katsudojo.com.br
JWT_SECRET=
# Fecha a rota POST /onboarding (só aceita quem mandar esta chave)
INTERNAL_API_KEY=

# Telegram desligado em produção
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
