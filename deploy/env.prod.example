# Modelo do .env de produção. No servidor: copie para .env (ao lado do
# compose.prod.yml) e troque os valores. Gere os segredos com:
#   openssl rand -hex 32

# Domínio e e-mail para o certificado HTTPS (Let's Encrypt)
DOMAIN=katsuflow.com.br
ACME_EMAIL=thiagotancredii@gmail.com

# Banco (a API monta a DATABASE_URL a partir desta senha)
POSTGRES_PASSWORD=

# API
ENVIRONMENT=prod
WEB_APP_URL=https://katsuflow.com.br
CORS_ORIGINS=https://katsuflow.com.br
JWT_SECRET=
# Cifra as chaves de API da InfinitePay no banco. Gere com:
#   docker compose -f compose.prod.yml run --rm api python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia fora do servidor: sem ela, as chaves salvas não abrem.
INFINITEPAY_SECRET_KEY=
# Único administrador (painel admin.katsuflow.com.br)
ADMIN_EMAIL=thiagotancredii@gmail.com

# Worker (Celery): o REDIS_URL vem do compose.prod.yml (serviço redis);
# não precisa definir aqui.
